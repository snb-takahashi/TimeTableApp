generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Desktop app: local SQLite file only, no server. DATABASE_URL points at
  // a file in the app's userData directory at runtime (set by the Electron
  // main process); for local `npm run dev` it points at prisma/dev.db.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Tokyo")
  createdAt DateTime @default(now())

  users                  User[]
  classGroups            ClassGroup[]
  subjects               Subject[]
  teachers               Teacher[]
  rooms                  Room[]
  timeSlots              TimeSlot[]
  entries                TimetableEntry[]
  curriculumRequirements CurriculumRequirement[]
  teacherUnavailability  TeacherUnavailability[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  role           Role         @default(MEMBER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
}

model ClassGroup {
  id             String       @id @default(cuid())
  name           String
  grade          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  entries                TimetableEntry[]
  curriculumRequirements CurriculumRequirement[]

  @@unique([organizationId, name])
}

model Subject {
  id             String       @id @default(cuid())
  name           String
  code           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  entries                TimetableEntry[]
  curriculumRequirements CurriculumRequirement[]

  @@unique([organizationId, name])
}

model Teacher {
  id             String       @id @default(cuid())
  name           String
  // 非常勤: part-time/adjunct teachers should have their periods kept
  // contiguous each day and be scheduled on as few distinct days as
  // possible, unlike full-time teachers.
  isPartTime     Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  entries                TimetableEntry[]
  curriculumRequirements CurriculumRequirement[]
  unavailability         TeacherUnavailability[]

  @@unique([organizationId, name])
}

model Room {
  id             String       @id @default(cuid())
  name           String
  capacity       Int?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  entries                     TimetableEntry[]
  preferredForRequirements    CurriculumRequirement[]

  @@unique([organizationId, name])
}

model TimeSlot {
  id             String       @id @default(cuid())
  dayOfWeek      DayOfWeek
  periodNumber   Int
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  entries TimetableEntry[]

  @@unique([organizationId, dayOfWeek, periodNumber])
}

model TimetableEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  timeSlotId String
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id])

  createdAt DateTime @default(now())

  // Conflict prevention: a class, a teacher, and a room can each only
  // appear once per time slot. The DB constraint is the source of truth;
  // app code pre-checks these for a friendly error message.
  @@unique([classGroupId, timeSlotId])
  @@unique([teacherId, timeSlotId])
  @@unique([roomId, timeSlotId])
}

// Describes what the auto-scheduler must place: this class needs this many
// periods/week of this subject, taught by this teacher (optionally in a
// preferred room). A (class, subject) pair can have multiple rows when the
// subject is team-taught by more than one teacher (each with their own
// periods/week share).
model CurriculumRequirement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  periodsPerWeek Int

  preferredRoomId String?
  preferredRoom   Room?   @relation(fields: [preferredRoomId], references: [id])

  @@unique([classGroupId, subjectId, teacherId])
}

// A teacher-specific blackout: this teacher cannot be scheduled at this
// day/period, regardless of class or subject.
model TeacherUnavailability {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  dayOfWeek    DayOfWeek
  periodNumber Int

  @@unique([teacherId, dayOfWeek, periodNumber])
}
